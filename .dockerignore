# 프론트엔드 이미지 빌드 컨텍스트에서 제외할 것들.
# 없으면 컨텍스트가 800MB 를 넘고, 호스트의 개발 DB(backend/data/*.db)와
# 오래된 .next 산출물까지 이미지로 딸려 들어간다.

# 의존성 — 이미지 안에서 npm ci 로 다시 설치한다
node_modules
backend/.venv

# 빌드 산출물 — 이미지 안에서 다시 만든다
.next
out
build

# 백엔드 (프론트 이미지에 필요 없음)
backend/data
backend/__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# 로컬 설정·비밀
.env
.env.*
!.env.example
.git
.github
.claude
.vscode
.idea
.obsidian

# 문서·참고자료 — 런타임에 필요 없음
docs
references
supabase
*.md

# 기타
.DS_Store
npm-debug.log*
coverage
