# ── Docker Compose ────────────────────────────────────────────────────────────
# APP_ENV=production 이면 아래 값이 기본값 그대로일 때 **서버가 뜨지 않는다.**
# 개발에서는 비워둬도 뜨지만 기동 로그에 경고가 남는다.
APP_ENV=development

# 실제 배포 전에 반드시 채운다:
#   JWT_SECRET=$(openssl rand -hex 32)
#   ADMIN_KEY=$(openssl rand -hex 32)
JWT_SECRET=
ADMIN_KEY=

# 쉼표로 여러 개. "*" 는 allow_credentials 와 함께라 프로덕션에서 거부된다.
ALLOWED_ORIGINS=http://localhost:3000

# ── 웹 프론트엔드 (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
